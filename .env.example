FLASK_APP=manage.py
FLASK_ENV=production
SECRET_KEY=change-this-long-random-value
DATABASE_URL=postgresql+psycopg://ticketesla:ticketesla@localhost:5432/ticketesla
LOG_LEVEL=INFO
STORAGE_PATH=storage
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,xlsx,docx,zip
REMEMBER_COOKIE_DAYS=60
REMEMBER_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true
RELEASE_VERSION=dev
BASE_URL=
EMAIL_ENABLED=false
EMAIL_BACKEND=smtp
EMAIL_DRY_RUN=true
EMAIL_DEBUG_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=10
TICKETESLA_ADMIN_USERNAME=admin
TICKETESLA_ADMIN_PASSWORD=change-me
TICKETESLA_ADMIN_EMAIL=admin@gmail.com
TICKETESLA_ADMIN_NAME=Administrador Ticketesla
