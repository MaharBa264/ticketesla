[Unit]
Description=Ticketesla
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/ticketesla/current
EnvironmentFile=/opt/ticketesla/.env
ExecStart=/opt/ticketesla/current/.venv/bin/gunicorn --workers 3 --threads 2 --bind 127.0.0.1:8020 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
